{
  "name": "codetrackr-vscode",
  "displayName": "CodeTrackr for VS Code",
  "description": "A VS Code extension for CodeTrackr, a time-tracking tool for developers. This extension automatically tracks your coding activity in Visual Studio Code and sends it to your CodeTrackr backend.",
  "publisher": "CodeTrackr-ext",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soham-Official/CodeTrackr.git"
  },
  "version": "2.0.11",
  "icon": "images/icon.png",
  "license": "MIT",
  "author": {
    "name": "Pratik Jambhule, Kartik Kharat, Soham",
    "url": "https://github.com/Soham-Official/CodeTrackr"
  },
  "contributors": [
    {
      "name": "Pratik Jambhule",
      "url": "https://github.com/PratikJambhule"
    },
    {
      "name": "Kartik Kharat",
      "url": "https://github.com/kartik-kharat"
    },
    {
      "name": "Soham",
      "url": "https://github.com/Soham-Official"
    }
  ],
  "homepage": "https://github.com/Soham-Official/CodeTrackr",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codetrackr.start",
        "title": "CodeTrackr: Start Tracking",
        "category": "CodeTrackr"
      },
      {
        "command": "codetrackr.stop",
        "title": "CodeTrackr: Stop Tracking",
        "category": "CodeTrackr"
      },
      {
        "command": "codetrackr.flushNow",
        "title": "CodeTrackr: Flush Now",
        "category": "CodeTrackr"
      },
      {
        "command": "codetrackr.showStats",
        "title": "CodeTrackr: Show Statistics",
        "category": "CodeTrackr"
      },
      {
        "command": "codetrackr.showLogs",
        "title": "CodeTrackr: Show Event Logs",
        "category": "CodeTrackr"
      },
      {
        "command": "codetrackr.setupApiKey",
        "title": "CodeTrackr: Setup API Key",
        "category": "CodeTrackr"
      },
      {
        "command": "codetrackr.showInfo",
        "title": "CodeTrackr: Show Connection Info",
        "category": "CodeTrackr"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "CodeTrackr Settings",
      "properties": {
        "codetrackr.apiBase": {
          "type": "string",
          "default": "https://codetrackr-backend-uckp.onrender.com",
          "description": "Your CodeTrackr backend API base URL. Leave as-is unless you are self-hosting."
        },
        "codetrackr.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your CodeTrackr API key. Run \"CodeTrackr: Setup API Key\" to set it, or copy it from your profile page."
        },
        "codetrackr.flushIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "How often the timer ticks (in seconds)."
        },
        "codetrackr.minFlushMinutes": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.1,
          "description": "Minimum minutes before a record is sent."
        },
        "codetrackr.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable debug logging for CodeTrackr event system."
        }
      }
    }
  },
  "keywords": [
    "code",
    "productivity",
    "tracking",
    "time tracking",
    "codetrackr",
    "mongodb",
    "atlas",
    "vscode"
  ],
  "scripts": {
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc -p ./ --noEmit",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "build": "npm run typecheck && npm run esbuild-base -- --minify",
    "watch": "npm run esbuild-base -- --sourcemap --watch",
    "package": "vsce package",
    "test": "node tests/trackers.test.js && node tests/activation.test.js",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.14.54",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^3.2.0"
  },
  "dependencies": {
    "axios": "^1.13.2"
  }
}
