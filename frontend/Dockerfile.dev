# Website in DEVELOPMENT mode for docker-compose.yml (Vite dev server with live reload).
# Not used in production: Vercel builds and serves the site there.
FROM node:24-alpine

WORKDIR /app

# Dependencies first, so editing source files does not reinstall them.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173
# --host 0.0.0.0 makes the dev server reachable from outside the container.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
