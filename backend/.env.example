# CodeTrackr backend configuration
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored — never commit real secrets.

# ---- Required ----------------------------------------------------------

# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codetrackr

# Secret used to sign session JWTs. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# There is a fallback of 'your_jwt_secret' in the code — never rely on it.
JWT_SECRET=

# Google OAuth credentials, from https://console.cloud.google.com/apis/credentials
# NOTE: config/passport.js throws at import time if any of these three are
# missing, so the API will not boot without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5050/auth/google/callback

# Where the dashboard runs. Used for CORS and post-login redirects.
FRONTEND_URL=http://localhost:5173

# ---- Optional ----------------------------------------------------------

# Port for the API. Defaults to 5050.
PORT=5050

# 'production' enables secure cookies and sameSite=none, and hard-disables
# AUTH_BYPASS. Leave unset for local development.
NODE_ENV=development

# DANGER: disables ALL authentication and attaches the user with the most
# tracked activity to every request. Local development only — it is refused
# outright when NODE_ENV=production. Leave unset unless you need it.
# AUTH_BYPASS=true
